# expect-exit: 101
# expect-stderr: bob: runtime trap: unowned reference to a destroyed object
program trapUnowned, 0.1.0
{
    class Owner {
        public { name: string := "gone"; }
    }

    class Ticket {
        public { @[unowned] owner: Owner; }
    }

    extends trapUnowned {
        @[static] msg main: args:array [int32] {
            owner: Owner? := Owner name: "x";
            ticket: Ticket? := nil;
            owner ifNotNil: { [o] ticket := Ticket owner: o; };
            owner := nil;
            # the owner is destroyed; reading the unowned reference traps
            ticket ifNotNil: { [t]
                name := t owner name;
                return 1;
            };
            return 0;
        }
    }
}
