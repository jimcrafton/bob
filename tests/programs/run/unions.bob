# expect-exit: 0
program unions, 0.1.0
{
    @[protocol] class Shape {
        msg area [int32];
    }
    class Square implements Shape {
        public { side: int32 := 2; }
        msg area [int32] { return side * side; }
    }
    class Circle implements Shape {
        msg area [int32] { return 3; }
    }

    extends unions {
        @[static] msg check: ok:bool id:int32 [int32] {
            return ok ifTrue: { 0 } ifFalse: { id };
        }

        @[static] msg main: args:array [int32] {
            failures := 0;

            mixed := [7, 8, "oiudf", 1.5];
            failures := failures + (self check: mixed count = 4 id: 1);
            failures := failures + (self check: (mixed at: 2) printString = "oiudf" and (mixed at: 0) printString = "7" id: 2);

            total := 0;
            strings := 0;
            for v in mixed {
                case v of {
                    int32:  { :n | total := total + n; }
                    string: { :s | strings := strings + s bytes count asInt32; }
                    real64: { :r | total := total + 100; }
                }
            }
            failures := failures + (self check: total = 115 and strings = 5 id: 3);

            found := 0;
            (mixed at: 1) ifKindOf: int32 do: { :n | found := n; };
            failures := failures + (self check: found = 8 and ((mixed at: 3) isKindOf: real64) id: 4);

            # classes that share a protocol: the element type is the protocol
            square: Square;
            circle: Circle;
            shapes := [square, circle];
            area := 0;
            for s in shapes {
                area := area + s area;
            }
            failures := failures + (self check: area = 7 id: 5);
            return failures;
        }
    }
}
