program hello, 0.1.0
import core.io;
{
    class Counter {
        private { count: int64; }
        msg increment { count := count + 1; }
        msg count [int64] { return count; }
    }

    extends hello {
        @[static] msg main: args:array [int32] {
            c: Counter;
            for i in 1 to: 10 {
                c increment;
            }
            if c count > 5 {
                io out println: "big";
            }
            return 0;
        }
    }
}
